es-chat-channel-speak-fmt-verb = [bold]{"{1}"}[/bold] {$verb}, "{"{0}"}"
es-chat-channel-speak-bold-fmt-verb = [bold]{"{1}"}[/bold] {$verb}, "[bold]{"{0}"}[/bold]"

es-chat-channel-whisper-fmt = [font size=11][italic]{"{1}"} whispers, "{"{0}"}"[/italic][/font]
es-chat-channel-emote-fmt = [italic]{"{1}"} {"{0}"}[/italic]

es-chat-identity-name-fmt = {CAPITALIZE(THE($name))}
es-chat-color-name-fmt = [color={$color}]{$name}[/color]
