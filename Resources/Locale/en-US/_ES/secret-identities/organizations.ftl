es-organization-crew-name = Crew
es-organization-crew-description = As a member of the Crew, try to keep things running smoothly, and ensure that the plan to teleport the station out of harm's way can succeed.

es-organization-traitor-name = Traitor
es-organization-traitor-description = As a Traitor, seek out your fellow operatives, complete the objectives the Syndicate has assigned to you, and try to detonate the station's nuke.

es-organization-parasite-name = Parasite
es-organization-parasite-description = As a Parasite, spread your parasitic infection across the station by driving others into violence and rage..
